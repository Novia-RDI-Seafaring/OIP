{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oip-for-agents/schemas/manifest.json",
  "title": "OIP manifest.json",
  "description": "The advertisement an OIP producer writes at the root of its data directory.",
  "type": "object",
  "required": ["oip_version", "producer", "data_dir", "produces", "invocation"],
  "properties": {
    "oip_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "OIP version this producer targets (semver MAJOR.MINOR)."
    },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Lowercase, alphanumeric + hyphens. Used as the registration filename."
        },
        "display_name": {"type": "string"},
        "version": {"type": "string"},
        "homepage": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "data_dir": {
      "type": "string",
      "description": "Absolute path to this producer's data directory."
    },
    "produces": {
      "type": "object",
      "required": ["source_kinds", "region_kinds", "source_ref_kinds"],
      "properties": {
        "source_kinds": {
          "type": "array",
          "items": {"type": "string"},
          "description": "MIME types this producer can ingest."
        },
        "region_kinds": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Region.kind values this producer emits."
        },
        "source_ref_kinds": {
          "type": "array",
          "items": {"type": "string"},
          "description": "source_ref.kind values this producer emits."
        }
      },
      "additionalProperties": false
    },
    "consumes": {
      "type": "object",
      "description": "Region kinds and content forms this producer derives from. Present on region producers (tools that enrich an existing region rather than ingest a source). Optional; introduced in OIP 0.3.",
      "properties": {
        "region_kinds": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Region.kind values this producer can act on."
        },
        "content_kinds": {
          "type": "array",
          "items": {"type": "string"},
          "description": "content keys that must be present on a consumed region (e.g. 'png')."
        }
      },
      "additionalProperties": false
    },
    "invocation": {
      "type": "object",
      "required": ["kind", "command", "tools_namespace"],
      "properties": {
        "kind": {"type": "string", "enum": ["mcp-stdio"]},
        "command": {"type": "string"},
        "args": {"type": "array", "items": {"type": "string"}},
        "tools_namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Tool-name prefix (e.g. 'pdf' → tools 'pdf.ingest')."
        }
      },
      "additionalProperties": false
    },
    "ui_hints": {
      "type": "object",
      "properties": {
        "node_types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string"},
              "renders": {"type": "string"}
            }
          }
        },
        "edge_styles": {"type": "object"},
        "source_ref_handlers": {"type": "object"}
      }
    },
    "agent": {
      "type": "object",
      "description": "Narrative skill content for AI consumers — the agent-side dual of ui_hints. Optional. Introduced in OIP 0.2.",
      "properties": {
        "skill_path": {
          "type": "string",
          "description": "Filesystem path to a markdown file containing the skill content, relative to manifest.json's directory."
        },
        "skill": {
          "type": "string",
          "description": "Inline markdown skill content. Mutually exclusive with skill_path."
        },
        "tool_skills_dir": {
          "type": "string",
          "description": "Directory containing per-tool skill files, one .md per tool, relative to manifest.json's directory. Reserved for tool-level skills; consumers may ignore this in 0.2."
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {"required": ["skill_path"], "not": {"required": ["skill"]}},
        {"required": ["skill"], "not": {"required": ["skill_path"]}},
        {"not": {"anyOf": [{"required": ["skill"]}, {"required": ["skill_path"]}]}}
      ]
    }
  },
  "additionalProperties": false
}
